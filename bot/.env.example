# ═══════════════════════════════════════════════════════
# Crebto Bot v0.7 — Sei EVM (Chain ID 1329)
# Quiet Wolf Long-Tail Arbitrage
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── RPC Endpoints ──
WS_RPC_URL=wss://evm-ws.sei-apis.com
HTTP_RPC_URL=https://evm-rpc.sei-apis.com

# ── Chain & Execution ──
CHAIN_ID=1329
DRY_RUN=true
PRIVATE_KEY=
EXECUTOR_ADDRESS=
CONTRACT_ADDRESS=

# ── Gas & Safety Limits ──
MAX_GAS_PRICE_GWEI=100
EXECUTION_GAS_LIMIT=600000
MIN_ETH_BALANCE=0.005

# ── Profit & Liquidity Filters ──
MIN_LIQUIDITY_USD=5000
MAX_LIQUIDITY_USD=30000
MIN_PROFIT_USD=1.0
MAX_TAX_BPS=500

# ── Trade Rate Limit ──
MAX_TRADES_PER_HOUR=15
MAX_DAILY_LOSS_USD=10.0
MAX_LOSS_PER_HOUR_USD=5.0
MAX_CONSECUTIVE_FAILURES=50

# ── DEX Factory Addresses (Sei EVM) ──
DRAGONSWAP_FACTORY=0x71f6b49ae1558357bbb5a6074f1143c46cbca03d
SAPPHIRE_FACTORY=

# ── Router (for safety simulation) ──
AERODROME_ROUTER=

# ── Multicall3 ──
MULTICALL3=

# ── Liquidity Locker ──
LIQUIDITY_LOCKER=

# ── Slippage & Probes ──
SLIPPAGE_BPS=15
PROBE_SIZES_USD=50,100

# ── Notifications ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
