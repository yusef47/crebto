# Alchemy WebSocket connection URL (Base L2)
ALCHEMY_WSS=wss://base-mainnet.g.alchemy.com/v2/your_alchemy_api_key

# DRY RUN MODE (true = monitor only, no real transactions)
DRY_RUN=true

# === OPTIONAL (only needed for LIVE mode) ===
# PRIVATE_KEY=0xyour_wallet_private_key
# CONTRACT_ADDRESS=0xyour_deployed_contract_address

# Telegram Configuration (Optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Kill Switch Safety Thresholds
MAX_GAS_PRICE_GWEI=100
MIN_ETH_BALANCE=0.005
MAX_LOSS_PER_HOUR_USD=5.0
MAX_CONSECUTIVE_FAILURES=50
